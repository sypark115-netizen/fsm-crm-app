# --- Claude (required for real agent work; without it Exi runs in demo mode) ---
ANTHROPIC_API_KEY=
# EXI_MODEL=claude-opus-5-5        # model for all agents
# EXI_EFFORT=low                   # low | medium | high (higher = better + slower + pricier)
# EXI_WEB_SEARCH=1                 # Researcher web search (0 to disable)

# --- Team access ---
# The first sign-up becomes the owner. Teammates join with this code; leave empty to close sign-ups.
EXI_INVITE_CODE=

# --- Feedback → GitHub issues (optional) ---
# Fine-grained token with "Issues: Read and write" on the repo below.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
# GITHUB_API_URL=https://api.github.com   # GitHub Enterprise: https://HOST/api/v3

# --- Behaviour ---
# EXI_REPLY_ALL=0                  # 1 = Exi answers every channel message, not only @Exi mentions
# EXI_MAX_CONCURRENT_RUNS=3
# EXI_DATA_DIR=./data              # SQLite DB + uploads
# TZ=Asia/Seoul                    # time zone for Maki schedules
